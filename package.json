{
  "name": "mydeepseek",
  "productName": "MyDeepSeek",
  "version": "1.0.0",
  "description": "Standalone DeepSeek desktop client",
  "main": "main.js",
  "type": "commonjs",
  "author": "Denys Oleksiienko",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.denysoleksiienko.mydeepseek",
    "productName": "MyDeepSeek",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "MyDeepSeek.icns"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules/.cache"
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}